{
  "manifest_version": 3,
  "minimum_chrome_version": "93",
  "name": "NYCU E3 Helper",
  "version": "2.2.0",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://e3.nycu.edu.tw/*",
    "https://e3p.nycu.edu.tw/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://translate.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "jszip.min.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "128.png",
      "48": "128.png",
      "128": "128.png"
    },
    "default_title": "NYCU E3 Helper"
  },
  "icons": {
    "16": "128.png",
    "48": "128.png",
    "128": "128.png"
  },
  "default_locale": "zh_TW",
  "options_ui": {
    "page": "notification-settings.html"
  }
}
